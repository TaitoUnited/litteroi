{
  "sourceLanguage": "fi",
  "strings": {
    "Avaa mikrofoniasetukset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open microphone settings"
          }
        }
      }
    },
    "Avaa näytön nauhoituksen asetukset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open screen recording settings"
          }
        }
      }
    },
    "Control-Optio-T tai Cmd+Q tallentaa. Litteroi Claude Codessa: litteroi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control-Option-T or Cmd+Q saves. Transcribe in Claude Code: litteroi"
          }
        }
      }
    },
    "Ei nauhoiteta": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not recording"
          }
        }
      }
    },
    "Lopeta ja tallenna": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop and save"
          }
        }
      }
    },
    "Mikrofoni": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone"
          }
        }
      }
    },
    "Mikrofonin käyttö on estetty. Salli se Litteroille järjestelmän asetuksista ja avaa Litteroi uudelleen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is blocked. Allow it for Litteroi in System Settings and open Litteroi again."
          }
        }
      }
    },
    "Nauhoitetaan": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording"
          }
        }
      }
    },
    "Nauhoitus ei käynnistynyt: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording did not start: %@"
          }
        }
      }
    },
    "Näyttöjä ei nauhoiteta: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screens are not recorded: %@"
          }
        }
      }
    },
    "Puhelun ääni": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call audio"
          }
        }
      }
    },
    "Puhelun ääntä ei nauhoiteta: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call audio is not recorded: %@"
          }
        }
      }
    }
  },
  "version": "1.0"
}
