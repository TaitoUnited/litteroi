    "Avaa Litteroi-kansio": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Litteroi folder"
          }
        }
      }
    },
    "Control-Optio-L": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control-Option-L"
          }
        }
      }
    },
    "Control-Optio-L aloittaa tai lopettaa nauhoituksen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control-Option-L starts or stops recording"
          }
        }
      }
    },
    "Ei nyt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        }
      }
    },
    "Litteroi nauhoittaa": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Litteroi is recording"
          }
        }
      }
    },
    "Litteroi nauhoittaa yhä. Lopetetaanko ja tallennetaan?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Litteroi is still recording. Stop and save it?"
          }
        }
      }
    },
    "Litteroidaanko? Kerro osallistujille ennen nauhoitusta.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribe it? Tell the participants before recording."
          }
        }
      }
    },
    "Lopeta ja tallenna": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop and save"
          }
        }
      }
    },
    "Nauhoita": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record"
          }
        }
      }
    },
